# Copy to .env and change every password. Never commit .env.
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis
S3_ACCESS_KEY=assurance
S3_SECRET_KEY=change-me-s3-secret
# First admin user, created on the first `migrate` only. Change it after logging in.
ASSURANCE_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
# Signs webhook payloads (X-Assurance-Signature: sha256=<hmac>)
ASSURANCE_WEBHOOK_SECRET=change-me-webhook-secret
ASSURANCE_LOG_LEVEL=INFO
# "live" connects to devices over SSH. "mock" reads mock_data/ (lab demo without devices).
ASSURANCE_COLLECTOR=live
ASSURANCE_WORKERS=2
