# Copy to .env and change every password. Never commit .env.
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis
S3_ACCESS_KEY=assurance
S3_SECRET_KEY=change-me-s3-secret
# First admin user, created on the first `migrate` only. Change it after logging in.
ASSURANCE_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
# Signs webhook payloads (X-Assurance-Signature: sha256=<hmac>)
ASSURANCE_WEBHOOK_SECRET=change-me-webhook-secret
ASSURANCE_LOG_LEVEL=INFO
# "live" connects to devices over SSH. "mock" reads mock_data/ (lab demo without devices).
ASSURANCE_COLLECTOR=live
ASSURANCE_WORKERS=2
# Scheduled report email (optional)
# ASSURANCE_SMTP_HOST=smtp.example.net
# ASSURANCE_SMTP_PORT=587
# ASSURANCE_SMTP_FROM=assurance@example.net
# Single sign-on (optional). Register https://<host>/api/v1/auth/oidc/callback with the IdP.
# ASSURANCE_OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# ASSURANCE_OIDC_CLIENT_ID=
# ASSURANCE_OIDC_CLIENT_SECRET=
# ASSURANCE_OIDC_REDIRECT_URI=https://assurance.example.net/api/v1/auth/oidc/callback
# ASSURANCE_OIDC_ROLE_MAP={"netops":"operator","netops-admins":"admin"}
# Behind a load balancer: believe its X-Forwarded-For
# ASSURANCE_TRUSTED_PROXIES=["10.0.0.0/8"]
