# TLS front end for Assurance (docker-compose.yml, service "proxy").
# ASSURANCE_TLS "internal" (default): Caddy's own CA. An e-mail address: Let's Encrypt for a public name.
# "/run/tls/cert.pem /run/tls/key.pem": your organisation's certificate.
# Caddy is the edge: it does not trust X-Forwarded-For from clients (users on private ranges could
# otherwise forge their address in the audit log and around the login rate limit). If a load balancer
# sits in front, add a global block: { servers { trusted_proxies static <LB address> } }

{$ASSURANCE_HOSTNAME} {
	tls {$ASSURANCE_TLS}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# Large CSV and XLSX exports, and fleet-wide pre/post on 500+ devices, can take a while.
	reverse_proxy api:8000 {
		transport http {
			read_timeout 300s
		}
	}
}
